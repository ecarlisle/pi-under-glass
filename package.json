{
  "name": "pi-under-glass",
  "version": "0.1.0",
  "description": "A tiny local browser view for Pi agent activity",
  "type": "module",
  "files": [
    "fixtures",
    "src",
    "viewer",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "observability"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run",
    "fallow": "npx fallow",
    "fallow:dead-code": "npx fallow dead-code --unused-files --unused-deps",
    "fallow:audit": "npx fallow audit --changed-since main",
    "fallow:fix-dry": "npx fallow fix --dry-run"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "fallow": "^3.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.34.4"
}
